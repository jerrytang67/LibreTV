# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：首页推荐数据源默认值（douban/bangumi/hot-list/douban-top250/bili/anilist/tvmaze），仅对未主动选择过的用户生效
# DEFAULT_RECOMMEND_SOURCE=douban

# 可选：调试
DEBUG=false

# 可选：自建弹幕服务（免申请密钥）。danmu_api 兼容弹弹play 的 /api/v2/* 契约，
# 聚合 B站/爱奇艺/腾讯/优酷/芒果等来源；compose 里已内置 danmu-api 服务（默认不启用）
# 启用方法：把下面这行指向容器内网地址，路径中的 token 必须与 DANMU_API_TOKEN 一致
# DANDANPLAY_API_BASE=http://danmu-api:9321/libretv2026
# DANMU_API_TOKEN=libretv2026

# 可选：外挂弹幕数据源（弹弹play 开放平台）。申请：https://doc.dandanplay.net/open/
# 不配置时观众也可在「设置 → 播放与过滤 → 弹幕」自填（仅存本机浏览器）
# DANDANPLAY_APP_ID=
# DANDANPLAY_APP_SECRET=
# 可选：自建反代时覆盖上游地址（默认 https://api.dandanplay.net）
# DANDANPLAY_API_BASE=

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/librespark/libretv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# LIBRETV_IMAGE=ghcr.io/librespark/libretv:<版本>
